# Trip Hunter environment configuration
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# .env is git-ignored and must NEVER be committed. This file only contains
# placeholder examples, never real credentials.
#
# Renamed from Vacation Hunter: use the TRIP_HUNTER_* names below for any
# new setup. An existing .env still using the old VACATION_HUNTER_* names
# keeps working (config.py falls back to them automatically) - no need to
# edit it immediately, but new variables should use TRIP_HUNTER_*.

# --- Active MVP provider: SerpApi Google Flights ---
# Free signup with a monthly search credit allowance: https://serpapi.com
TRIP_HUNTER_SERPAPI_KEY=your_api_key_here

# Optional overrides - defaults shown, uncomment to change.
# TRIP_HUNTER_SERPAPI_CURRENCY=EUR

# --- Amadeus Self-Service (kept for architecture/history, not the active
# MVP provider - Amadeus discontinued self-service signup for new
# developers. See docs/PRODUCT_SPEC.md.) ---
# TRIP_HUNTER_FLIGHT_API_KEY=your_api_key_here
# TRIP_HUNTER_FLIGHT_API_SECRET=your_api_secret_here
# TRIP_HUNTER_FLIGHT_API_BASE_URL=https://test.api.amadeus.com

# --- Shared across providers ---
# TRIP_HUNTER_CACHE_TTL_SECONDS=86400
# TRIP_HUNTER_REQUEST_TIMEOUT_SECONDS=10

# --- Multi-origin sampling (sampling_targets.py, "flexible Abflughäfen") ---
# Comma-separated IATA departure-airport codes. daily_sampler.py picks ONE
# of these per calendar day (round-robin, sampling_targets.origin_of_the_day)
# to add one extra flight target per existing trip template - never a
# cross product of all origins x all destinations. Default shown below.
# TRIP_HUNTER_ORIGINS=HAM,BER,FRA,MUC,DUS

# --- Instant-alert budget (engine/deal_filters.py, DEFAULT_INSTANT_ALERT_CRITERIA) ---
# Duration-aware cap, not one flat total: a weekend-shaped trip (<=3
# nights) must stay under WEEKEND_MAX_TOTAL EUR total; a longer trip is
# judged on the accommodation's EUR/night price instead
# (MAX_PRICE_PER_NIGHT) - a great week-long flight deal is never excluded
# just because nights x hotel alone would exceed a weekend-sized budget.
# TRIP_HUNTER_WEEKEND_MAX_TOTAL=250
# TRIP_HUNTER_MAX_PRICE_PER_NIGHT=60

# --- Feed sensor (engine/feed_sensor.py) ---
# Optional self-hosted mirror for a deal feed, tried BEFORE the official
# URL: TRIP_HUNTER_FEED_MIRROR_<SOURCE> with SOURCE one of TRAVELDEALZ,
# SECRETFLYING, FLYERTALK, URLAUBSPIRATEN, FLY4FREE, FLYNOUS, MYDEALZ. Secret Flying's own feed is
# behind a Cloudflare challenge; point this at e.g. your own RSSHub/proxy
# serving RSS 2.0 or Atom (RSS-Bridge's default). Flynous is WAF-blocked for
# scripts too, so a mirror is the only way to get it. Public instances (rsshub.app) refuse most clients.
# Unset/empty = only the built-in URLs. Dead mirrors are skipped silently.
# TRIP_HUNTER_FEED_MIRROR_SECRETFLYING=https://your-mirror.example/secretflying.xml

# --- Free channel funnel (monetization/upsell.py) ---
# FREE_CHANNEL_MODE: "teaser" (default) = the Free channel gets a masked
# teaser at once (rough period, no hotel name, no booking link, blurred
# photo) with two buttons; "delayed_full" = it gets the COMPLETE alert
# FREE_CHANNEL_DELAY_HOURS later (default 24; the sampler sends due items
# at the end of a run, so with the Mon/Wed/Fri/Sun schedule an item goes
# out at the first run after it is due). VIP is always immediate.
# FREE_CHANNEL_MODE=teaser
# FREE_CHANNEL_DELAY_HOURS=24
#
# Button "⚡️ Jetzt Deal buchen (VIP freischalten)": VIP_SUBSCRIPTION_URL
# (https only), else https://t.me/<TELEGRAM_BOT_USERNAME>?start=vip, else
# the landing page's pricing section.
# VIP_SUBSCRIPTION_URL=https://buy.stripe.com/your_link
# TELEGRAM_BOT_USERNAME=YourTripHunterBot
# Button "ℹ️ Wie funktioniert Trip Hunter?" (default: landing page #how):
# FAQ_URL=https://example.org/faq
#
# Button "📲 Mit Reise-Buddy teilen": opens WhatsApp with a pre-written
# message (destination, per-person total, this invite link - never a
# booking link). Your Free channel's invite link; fallback
# https://t.me/<TELEGRAM_BOT_USERNAME>, else the landing page:
# FREE_CHANNEL_INVITE_URL=https://t.me/+your_invite_code
#
# The VIP alert's "Deal sichern" button opens web/deal.html on GitHub
# Pages; override the address or switch it off (=off -> plain booking
# buttons) with:
# DEAL_SHEET_URL=https://jeremyduehrkop97-art.github.io/TripHunter/deal.html

# --- Monetization: booking buttons (monetization/link_builder.py) ---
# VIP alerts carry two inline buttons, "Flug prüfen" and "Hotel ansehen".
# Every ID below is OPTIONAL: unset/empty = a clean, untracked search link
# (Google Flights / Booking.com search), never an error.
#
# Booking.com partner ID -> adds `aid=<id>` to the hotel search link:
# BOOKING_AFFILIATE_ID=your_booking_aid
#
# Travelpayouts marker -> flights use an Aviasales search link with
# `marker=<marker>` (the default provider as soon as this is set):
# TRAVELPAYOUTS_MARKER=your_marker
#
# Optional: pick the flight link provider (google | aviasales | skyscanner)
# and, for Skyscanner-through-Travelpayouts, the program ID of your
# Travelpayouts program list (never guessed - without it the Skyscanner
# link stays untracked). HOTEL_LINK_PROVIDER=google gives an untracked
# Google Hotels search instead of Booking.com.
# FLIGHT_LINK_PROVIDER=aviasales
# TRAVELPAYOUTS_SKYSCANNER_PROGRAM_ID=
# TRAVELPAYOUTS_CAMPAIGN_ID=
# HOTEL_LINK_PROVIDER=booking
#
# Earning commission still needs an approved partner account with each
# program: the IDs only mark the links.
#
# Legacy tag (monetization/affiliate.py): TRIP_HUNTER_AFFILIATE_TAG is
# appended as `tp_aff` to provider-supplied links in the newsletter/
# printout "👉" lines only. It does not affect the alert buttons.
# TRIP_HUNTER_AFFILIATE_TAG=your_affiliate_tag_here

# --- Dispatch: Telegram (dispatch/telegram.py) ---
# Create a bot via @BotFather on Telegram to get a bot token, then send
# it any message and call https://api.telegram.org/bot<TOKEN>/getUpdates
# to read back your chat_id. Leave unset and alerts are printed as a
# transparent fallback instead of being sent - never a hard failure.
# TRIP_HUNTER_TELEGRAM_BOT_TOKEN=your_bot_token_here

# Single-channel fallback: used only if NEITHER of the Free/VIP channel
# IDs below is set (dispatch_deal_alert's legacy single-chat behavior).
# TRIP_HUNTER_TELEGRAM_CHAT_ID=your_chat_id_here

# Dual-channel routing (dispatch_deal_alert): deliberately plain
# TELEGRAM_* names, not TRIP_HUNTER_-prefixed, matching how the channel
# IDs were provisioned. VIP gets every alert-worthy deal in full detail
# incl. affiliate-tagged booking links; Free gets the same deal as a
# link-free teaser with a VIP-upgrade hint.
# TELEGRAM_FREE_CHAT_ID=your_free_channel_chat_id_here
# TELEGRAM_VIP_CHAT_ID=your_vip_channel_chat_id_here

# Manual dual-channel verification: python -m scripts.send_test_alert
# sends a mocked COMBINED_TRIP_DROP deal through dispatch_deal_alert so
# both channels above can be checked live, without any SerpApi credits.
