__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
dist/
.DS_Store

# Secrets - never commit real credentials.
.env

# Local cache of API responses - disposable, rebuildable.
data/cache/

# Local price history database(s) - runtime state, not project data.
# data/trip_hunter.db is the real history; data/demo_trip_hunter.db
# is the isolated demo/fixture database (see "Real vs Fixture Data
# Hygiene" in docs/PRODUCT_SPEC.md) - both covered by the pattern below.
data/trip_hunter.db
data/*.db

# Generated newsletter/alert exports (build_newsletter.py) - runtime
# output, not project data, regenerated on every run.
output/

# scripts/run_daily.sh log output - runtime state, not project data.
logs/
